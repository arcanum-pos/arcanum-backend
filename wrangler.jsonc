{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "questo-bancontact-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-11",
	// Not directly publicly reachable — only questo-bff calls this Worker (via
	// the BANCONTACT_SERVICE service binding, which works regardless of this
	// setting). The iOS SumUp bridge used to depend on the workers.dev URL
	// directly (bearer-token gated); now retired. Explicit here so it doesn't
	// silently come back on a future deploy — that's the actual bug this is
	// fixing: workers_dev defaults to true when unset, so a same-day dashboard
	// toggle-off would otherwise be clobbered by the next `wrangler deploy`.
	"workers_dev": false,
	"dev": {
		"port": 8789,
		"inspector_port": 9889
	},
	"vars": {
		"AUTH_SCHEME": "Bearer"
	},
	"services": [
		{
			"binding": "DEVICEHUB_SERVICE",
			"service": "questo-devicehub"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SETTINGS",
			"id": "1a77d762d41f4fefb159050422ff86eb"
		}
	],
	"d1_databases": [
		
		{
			"binding": "DB",
			"database_name": "questo-transactions",
			"database_id": "e89eefb2-b515-4e44-976f-73b9d0de6558"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SUMUP_COORDINATOR",
				"class_name": "SumupChargeCoordinator"
			}
		]
	},
	"migrations": [
		// new_sqlite_classes (not new_classes): Durable Objects on the Workers
		// Free plan require the SQLite storage backend. Same storage.get/put/
		// list/delete API we already use, so no code changes needed.
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"SumupChargeCoordinator"
			]
		}
	],
	"ratelimits": [
		{
			"name": "AUTH_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 1,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true
	}
}