{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "arcanum-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-11",
	// Not directly publicly reachable — only arcanum-bff calls this Worker (via
	// the ARCANUM_BACKEND_SERVICE service binding, which works regardless of this
	// setting). The iOS SumUp bridge used to depend on the workers.dev URL
	// directly (bearer-token gated); now retired. Explicit here so it doesn't
	// silently come back on a future deploy — that's the actual bug this is
	// fixing: workers_dev defaults to true when unset, so a same-day dashboard
	// toggle-off would otherwise be clobbered by the next `wrangler deploy`.
	"workers_dev": false,
	"dev": {
		"port": 8789,
		"inspector_port": 9889
	},
	"vars": {
		"AUTH_SCHEME": "Bearer",
		"PUBLIC_BASE_URL": "https://arcanum.kaboutersoft.be",
		// kaboutersoft.be — the zone Custom Hostnames (org custom domains) are
		// registered against. Its Fallback Origin is arcanum.kaboutersoft.be
		// (already configured, points at this same app), so any org's
		// validated custom domain proxies straight through with no further
		// per-hostname routing step. Not secret — paired with the
		// CLOUDFLARE_API_TOKEN secret (Zone > SSL and Certificates > Edit).
		"CLOUDFLARE_ZONE_ID": "f68954584752839bfd85b0b143ed6f9d"
	},
	"services": [
		{
			"binding": "ARCANUM_DEVICEHUB_SERVICE",
			"service": "arcanum-devicehub"
		},
		{
			"binding": "ARCANUM_MAILER_SERVICE",
			"service": "arcanum-mailer"
		}
	],
	"d1_databases": [
		
		{
			"binding": "DB",
			"database_name": "arcanum-backend",
			"database_id": "684e3e7c-2859-429e-a5d3-d8159b0bf86d",
			// `wrangler d1 migrations apply arcanum-backend --remote` — tracked in
			// the d1_migrations table (schema.sql marks all of them applied for a
			// fresh database).
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "CHARGE_POLLER",
				"class_name": "ChargePoller"
			}
		]
	},
	"migrations": [
		// new_sqlite_classes (not new_classes): Durable Objects on the Workers
		// Free plan require the SQLite storage backend. Same storage.get/put/
		// list/delete API we already use, so no code changes needed.
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"SumupChargeCoordinator"
			]
		},
		// SumupChargeCoordinator was the iOS SumUp Air bridge's polling-queue
		// entry point (retired — a specific Solo reader is targeted directly
		// now). Renamed rather than deleted+recreated: it now holds no charge
		// data of its own (that moved to D1's `charges` table), just a
		// fallback poll alarm.
		{
			"tag": "v2",
			"renamed_classes": [
				{
					"from": "SumupChargeCoordinator",
					"to": "ChargePoller"
				}
			]
		},
		// Purely cosmetic cleanup: the DO namespace created at v1 is still
		// internally labeled with the script's pre-rename name
		// (questo-bancontact-worker) -- Cloudflare's dashboard never updates
		// that label on a later Worker rename. Retiring and recreating the
		// class here (safe: confirmed no data is ever written to it, see
		// poller.ts -- the only storage call is getAlarm/setAlarm) gets a
		// fresh namespace labeled under the current name, arcanum-backend.
		// Done while there's no live traffic; losing a scheduled alarm
		// mid-flight would be harmless anyway (ensureChargePolling
		// re-arms it on the next charge dispatch).
		{
			"tag": "v3",
			"deleted_classes": [
				"ChargePoller"
			]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": [
				"ChargePoller"
			]
		}
	],
	"observability": {
		"enabled": true
	}
}