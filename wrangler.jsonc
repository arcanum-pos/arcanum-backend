{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "questo-bancontact-worker",
	"main": "src/index.js",
	"compatibility_date": "2026-09-11",
	"vars": {
		"BANCONTACT_ENVIRONMENT": "prod",
		"AUTH_SCHEME": "Bearer"
	},
	"kv_namespaces": [
		{
			"binding": "SETTINGS",
			"id": "1a77d762d41f4fefb159050422ff86eb"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "SUMUP_COORDINATOR", "class_name": "SumupChargeCoordinator" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_classes": ["SumupChargeCoordinator"] }
	],
	"ratelimits": [
		{
			"name": "AUTH_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 1,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true
	}
}