{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "questo-bancontact-worker",
	"main": "src/index.js",
	"compatibility_date": "2026-09-11",
	"vars": {
		"BANCONTACT_ENVIRONMENT": "prod",
		"AUTH_SCHEME": "Bearer"
	},
	"kv_namespaces": [
		{
			"binding": "SETTINGS",
			"id": "1a77d762d41f4fefb159050422ff86eb"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "SUMUP_COORDINATOR", "class_name": "SumupChargeCoordinator" }
		]
	},
	"migrations": [
		// new_sqlite_classes (not new_classes): Durable Objects on the Workers
		// Free plan require the SQLite storage backend. Same storage.get/put/
		// list/delete API we already use, so no code changes needed.
		{ "tag": "v1", "new_sqlite_classes": ["SumupChargeCoordinator"] }
	],
	"ratelimits": [
		{
			"name": "AUTH_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 1,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true
	}
}