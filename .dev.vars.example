# Shared secret for server-to-server calls to arcanum-devicehub's
# /devices/broadcast — must match the same secret set on that Worker.
INTERNAL_API_KEY=change-me-to-a-long-random-value

# Platform-wide key-encryption-key wrapping each organization's own data key
# (envelope encryption — see src/organizations/crypto.ts).
ENCRYPTION_KEY=change-me-to-a-long-random-value

# Authorizes arcanum-bff's calls to this Worker's internal-only
# identity-provider-resolution route — must match arcanum-bff's own
# BFF_INTERNAL_KEY. A different secret from INTERNAL_API_KEY above (that
# one's for this Worker's own calls to arcanum-devicehub).
BFF_INTERNAL_KEY=change-me-to-a-long-random-value

# Seeds the platform-default identity provider the first time it's needed
# (see organizations/identity-providers.ts ensureDefaultOrganization) — an
# existing OIDC app's issuer/client id/secret. Consumed once; can be left
# unset if you don't need to test login locally.
DEFAULT_IDP_ISSUER_URL=
DEFAULT_IDP_CLIENT_ID=
DEFAULT_IDP_CLIENT_SECRET=
DEFAULT_IDP_CONNECTION_NAME=
# Optional (Google): scopes without offline_access, e.g. "openid profile email",
# and a separate Web-application client for browser login.
DEFAULT_IDP_SCOPES=
DEFAULT_IDP_AUTH_CODE_CLIENT_ID=
DEFAULT_IDP_AUTH_CODE_CLIENT_SECRET=

# Local `wrangler dev` URL for the arcanum-mailer Worker (run it on a different port).
MAILER_LOCAL_URL=http://localhost:8792

# Authorizes calls to arcanum-mailer's /send route — must match arcanum-mailer's
# own MAILER_INTERNAL_KEY.
MAILER_INTERNAL_KEY=change-me-to-a-long-random-value

# Seeds the platform-default SMTP account the first time it's needed (see
# organizations/smtp-credentials.ts ensureDefaultSmtpCredentials) — a
# personal Gmail account + app password works fine. Consumed once; can be
# left unset if you don't need to test sending locally.
DEFAULT_SMTP_HOST=smtp.gmail.com
DEFAULT_SMTP_PORT=587
DEFAULT_SMTP_USER=
DEFAULT_SMTP_PASS=
DEFAULT_SMTP_FROM_ADDRESS=
DEFAULT_SMTP_FROM_NAME=Arcanum

